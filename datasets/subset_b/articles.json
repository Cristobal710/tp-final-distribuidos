    },
    "date_created": "2005-06-17T19:58:02",
    "date_modified": "2026-04-03T21:43:50",
    "abstract": "Otto-Ernst Flick was the oldest of three sons born to Friedrich Flick and wife Marie Schuss in 1916 in Germany.",
    "sections": [
      {
        "type": "section",
        "name": "Abstract",
        "has_parts": [
          {
            "type": "paragraph",
            "value": "Otto-Ernst Flick (27 June 1916 – 4 January 1974) was the oldest of three sons born to Friedrich Flick and wife Marie Schuss in 1916 in Germany.",
            "links": [
              {
                "url": "https://en.wikipedia.org/wiki/Friedrich_Flick",
                "text": "Friedrich Flick"
              }
            ]
          }
        ]
      },
      {
        "type": "section",
        "name": "Biography",
        "has_parts": [
          {
            "type": "paragraph",
            "value": "Otto-Ernst was born on June 27, 1916.",
            "links": [
              {
                "url": "https://en.wikipedia.org/wiki/Otto-Ernst_Flick#cite_note-:0-1"
              },
              {
                "url": "https://en.wikipedia.org/wiki/Otto-Ernst_Flick#cite_note-2"
