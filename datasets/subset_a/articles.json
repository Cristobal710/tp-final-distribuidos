        "type": "section",
        "name": "Abstract",
        "has_parts": [
          {
            "type": "paragraph",
            "value": "Dubh Essa Bean Uí Dubhda (died 1190) was a queen of Ui Fiachrach Muaidhe.",
            "links": [
              {
                "url": "https://en.wikipedia.org/wiki/Queen_consort",
                "text": "queen"
              },
